# =============================================================================
# CodeScan — copy to `.env` and fill real values.
# Neon: https://console.neon.tech → Project → Connect
# =============================================================================

# Pooled (hostname has "-pooler") — Next.js app
DATABASE_URL="postgresql://USER:PASSWORD@ep-XXXX-pooler.REGION.aws.neon.tech/neondb?sslmode=require"

# Direct (no "-pooler") — Prisma migrate / db push
# If Neon only shows one link: copy it and remove "-pooler" from the host.
DIRECT_URL="postgresql://USER:PASSWORD@ep-XXXX.REGION.aws.neon.tech/neondb?sslmode=require"

# ---------------------------------------------------------------------------
# Public URL baked into every QR image (scanner shows this host).
# Use a CUSTOM domain — not https://something.vercel.app
#
# Local:        http://localhost:3000
# Production:   https://go.goalkeepers.org.in
#               or https://goalkeepers.org.in  (if /r/* is routed here)
#
# Setup (production):
# 1. Vercel → Project → Settings → Domains → add go.goalkeepers.org.in
# 2. DNS: CNAME go → cname.vercel-dns.com (or as Vercel shows)
# 3. Set this env on Vercel + redeploy
# 4. Re-download QR PNGs so they encode the new host
# ---------------------------------------------------------------------------
# VALUE ONLY — do not paste "NEXT_PUBLIC_APP_URL=..." into the value field on Vercel.
# Name:  NEXT_PUBLIC_APP_URL
# Value: https://go.goalkeepers.org.in
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional: lock /dashboard and /qr/* with a simple password.
# Leave empty for open local testing. Public /r/* scans never need this.
ADMIN_PASSWORD=""
